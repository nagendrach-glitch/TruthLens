# ─── Secrets & Environment ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Virtual Environment ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Python Cache ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ─── Build & Distribution (Hatchling / pip install -e .) ──────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/
*.dist-info/

# ─── Streamlit ────────────────────────────────────────────────────────────────
.streamlit/secrets.toml
.streamlit/

# ─── CrewAI Runtime Artifacts ─────────────────────────────────────────────────
.crewai/
*.db
*.sqlite
chroma/
chroma_db/

# ─── LangChain / LangSmith ────────────────────────────────────────────────────
.langchain/
langchain.db

# ─── Knowledge Directory (may contain private user data) ──────────────────────
knowledge/*.txt
knowledge/*.pdf
knowledge/*.docx
# Keep the directory tracked but not its contents:
!knowledge/.gitkeep

# ─── File Uploads & Processed Outputs ────────────────────────────────────────
uploads/
outputs/
tmp/
temp/
*.tmp

# ─── Report Downloads Generated by the App ───────────────────────────────────
truthlens_verification_report.txt
truthlens_verification_report.md

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── IDE & Editor ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── OS Artifacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
